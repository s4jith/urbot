# ─────────────────────────────────────────────────────────────────────────────
# Interview Bot — Environment Configuration Template
# Copy this file to backend/.env and fill in every required value.
# Lines starting with # are comments. Never commit your real .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# "production" enforces cloud URLs; "development" relaxes checks for localhost.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Gemini AI ────────────────────────────────────────────────────────────────
# Required. Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...your_primary_key

# Optional. Comma-separated additional keys for round-robin load balancing.
# Free tier is 15 RPM per key; 4 keys = 60 RPM capacity (enough for 30 users).
GEMINI_API_KEYS=AIza...key2,AIza...key3,AIza...key4

# Model to use. gemini-2.5-flash is the default (fast + good quality).
GEMINI_MODEL=gemini-2.5-flash

# Optional comma-separated fallback models if the primary is unavailable.
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Required. Create a free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=interview_bot

# ── Redis ────────────────────────────────────────────────────────────────────
# Required. Free tier: https://upstash.com (use rediss:// for TLS)
# For local dev with Docker: redis://localhost:6379
REDIS_URL=rediss://your_redis_host:6380

# ── JWT ──────────────────────────────────────────────────────────────────────
# Required. Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_ALGORITHM=HS256
# Token lifetime in seconds. 3600 = 1 hour. Silent refresh extends sessions automatically.
JWT_EXPIRY=3600

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your frontend URL. Use comma-separated values for multiple origins.
# Leaving as * is insecure in production — a warning will appear in logs.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Auth / Roles ──────────────────────────────────────────────────────────────
# Only emails ending with this domain are granted admin role on signup.
# Change to your institution domain, e.g. @college.edu
# Leaving as @admin.com is insecure — a warning will appear in logs.
ADMIN_EMAIL_DOMAIN=@college.edu

# ── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── TTS (XTTS v2) ────────────────────────────────────────────────────────────
# Maximum concurrent XTTS synthesis jobs. Increase if you have a GPU.
TTS_MAX_CONCURRENT=4
# Set to 1 to force CPU mode even if a GPU is present.
# XTTS_FORCE_CPU=0

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# Used by docker-compose to bake the API URL into the frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of your deployed frontend. Used in password-reset email links.
FRONTEND_URL=http://localhost:3000

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Required for OTP verification and password-reset emails.
# Leave SMTP_HOST empty to run without email — OTP codes will be logged to the
# console instead (useful for local development).
#
# Gmail example (requires a Google App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx   (16-char App Password)
#   SMTP_FROM_EMAIL=you@gmail.com
#
# Outlook/Hotmail example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Interview Bot
# True = STARTTLS (port 587). False = plain/SSL-wrapped (port 465).
SMTP_USE_TLS=true

# OTP and reset-token lifetimes (seconds)
OTP_TTL_SECONDS=600          # 10 minutes
RESET_TOKEN_TTL_SECONDS=1800 # 30 minutes

# ── Tests ────────────────────────────────────────────────────────────────────
# Integration tests use a separate database so they never touch production data.
# Run tests from the backend/ directory: pytest
TEST_MONGO_DB_NAME=interview_bot_test
